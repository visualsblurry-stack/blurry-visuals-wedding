# Agent and assistant working directories. These hold local scratch state,
# worktrees and machine-specific launch configs — nothing another checkout of
# this repo can use.
.worktrees/
.superpowers/
.claude/
.codex/
.cursor/
.continue/
.windsurf/
.gstack/
.aider*

# Editor and OS droppings.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Secrets. Nothing in this site needs them today; the rule is here so a
# stray key never becomes a commit.
.env
.env.*
*.pem

# Dependencies and build output, should this ever gain a toolchain.
node_modules/
.cache/
__pycache__/
*.pyc
*.log
npm-debug.log*

# Full-resolution originals. These are converted into img/hero/*.webp for the
# site; committing the multi-megabyte source files only bloats the repo.
img/*.jpg
img/*.jpeg
img/*.png
!img/blurry-visuals-logo.png
!img/blurry-visuals-logo-web.png
# The sharing card is a shipped asset, not a source original — every WhatsApp
# and social preview fetches it, so it has to be in the repo.
!img/og-blurry-visuals.jpg

# Wedding films are large binaries; keep them out of git history.
video/stories/*
!video/stories/.gitkeep

# Engineering-only: agent planning docs, session handoff notes, the test
# suite, and the gallery/photo build scripts. None of this is served to a
# visitor, so none of it belongs in the deployed site's repo. Keep it in
# whatever working checkout needs it locally instead.
docs/superpowers/
CLAUDE_HANDOFF.md
tests/
tools/
